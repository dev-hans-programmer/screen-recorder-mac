{
  "name": "@screen-recorder/desktop",
  "productName": "Screen Recorder",
  "version": "0.1.0",
  "description": "A native-feeling macOS screen recorder.",
  "main": ".vite/build/main.js",
  "author": "Screen Recorder",
  "license": "MIT",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
