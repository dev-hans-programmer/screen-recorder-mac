{
  "name": "screen-recorder-workspace",
  "private": true,
  "version": "0.1.1",
  "description": "A native-feeling macOS screen recorder built with React, Electron, TypeScript, and Swift.",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "start": "pnpm native:build && pnpm --filter @screen-recorder/desktop start",
    "dev": "pnpm native:build && pnpm --filter @screen-recorder/desktop start",
    "package": "pnpm native:build && pnpm --filter @screen-recorder/desktop package",
    "make": "pnpm native:build:universal && pnpm --filter @screen-recorder/desktop make:universal",
    "typecheck": "pnpm --filter @screen-recorder/desktop typecheck",
    "lint": "eslint apps packages",
    "test": "pnpm --filter @screen-recorder/desktop test && pnpm native:test",
    "native:build": "swift build -c release --package-path native/CaptureService",
    "native:build:universal": "node scripts/build-native-universal.mjs",
    "native:test": "swift run --package-path native/CaptureService CaptureServiceCoreTests && swift run --package-path native/CaptureService CaptureServiceSmokeTests",
    "native:run": "swift run --package-path native/CaptureService CaptureService",
    "quality:validate": "node scripts/validate-recording.mjs",
    "test:packaged": "node scripts/verify-package.mjs && node scripts/packaged-smoke.mjs",
    "test:packaged:probe": "node scripts/packaged-smoke.mjs --skip-recording",
    "test:hardware:probe": "node scripts/hardware-validation.mjs",
    "test:compatibility": "node scripts/hardware-validation.mjs --compatibility --output validation-results/compatibility.json",
    "test:performance": "node scripts/hardware-validation.mjs --performance --output validation-results/performance.json",
    "artifacts:checksums": "node scripts/generate-checksums.mjs apps/desktop/out/make",
    "artifacts:verify": "node scripts/generate-checksums.mjs apps/desktop/out/make --verify",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "clean": "rimraf apps/desktop/.vite apps/desktop/out apps/desktop/coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "typescript-eslint": "8.71.0"
  }
}
